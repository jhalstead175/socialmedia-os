# Rezemai Environment Variables
# Copy this file to .env and fill in the values

# Base44 Configuration
# The Base44 App ID for your project
# Default: Uses hardcoded fallback if not set
VITE_BASE44_APP_ID=68aceeea253a7630b16aa021

# Application Configuration
# The base URL for your application (used in email links)
# Default: https://app.rezemai.com
VITE_APP_URL=https://app.rezemai.com

# Environment
# Options: development, staging, production
# Default: production
VITE_ENVIRONMENT=production
